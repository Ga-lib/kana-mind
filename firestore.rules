rules_version = '2';

// KanaMind: each signed-in user owns exactly one progress document, keyed by their uid.
// Nobody can read, list or write anyone else's document; everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /kanamind_users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProgress() {
        let d = request.resource.data;
        return d.keys().hasOnly(['cards', 'notes', 'streak', 'xp', 'history', 'updatedAt', 'v'])
          && d.cards is map && d.notes is map && d.history is map && d.streak is map
          && d.xp is int && d.xp >= 0
          && d.v is int
          && d.updatedAt == request.time;
      }
      allow get: if isOwner();
      allow create, update: if isOwner() && validProgress();
      allow delete: if isOwner();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
